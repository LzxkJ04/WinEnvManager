{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinEnvManager",
  "version": "2.0.0",
  "identifier": "com.winenv.manager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5299",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "WinEnv管家 · Windows环境与开发环境一体化管理工具",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": ["resources/rules.json"],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
