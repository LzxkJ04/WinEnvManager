{
  "ruleVersion": "1.0",
  "ruleList": [
    {
      "id": "jdk-1438461",
      "name": "JDK",
      "alias": [
        "java",
        "jdk",
        "openjdk",
        "corretto"
      ],
      "category": "编程语言运行时",
      "enable": true,
      "description": "JDK 运行时，自动生成 JAVA_HOME 并把 bin 加入 PATH",
      "scanSource": [
        "registry",
        "path-scan",
        "customDir"
      ],
      "executableName": "java.exe",
      "versionCmd": "-version",
      "versionRegex": "version \"(\\d+(?:\\.\\d+)?[^\"]*)\"",
      "installPathExtract": {
        "mode": "parentNLevel",
        "level": 1
      },
      "envTemplate": [
        {
          "varKey": "JAVA_HOME",
          "varValue": "{{installPath}}",
          "scope": "user",
          "remark": "JDK 主目录",
          "pathPosition": ""
        },
        {
          "varKey": "PATH",
          "varValue": "{{installPath}}\\bin",
          "scope": "user",
          "remark": "JDK bin 目录",
          "pathPosition": "prepend"
        }
      ],
      "dependRuleIds": [],
      "ignoreIfExists": false,
      "customCheckScript": "",
      "tags": [
        "java",
        "jdk"
      ],
      "builtin": true
    },
