{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinEnv管家安装向导",
  "version": "1.2.1",
  "identifier": "com.winenv.bootstrapper",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "WinEnv管家 安装向导",
        "width": 860,
        "height": 680,
        "minWidth": 820,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "additionalBrowserArgs": "--remote-debugging-port=9225 --remote-allow-origins=*"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": ["icons/icon.ico"]
  }
}
